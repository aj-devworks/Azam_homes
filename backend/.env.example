# --- Flask ---
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-value

# --- Database ---
# postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://azam_user:strong_password@localhost:5432/azam_homes

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-different-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_MIN=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://azam-homes.vercel.app,http://localhost:5173

# --- Rate limiting / token blocklist (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- First admin bootstrap (used once by seed script) ---
ADMIN_EMAIL=admin@azamhomes.com
ADMIN_PASSWORD=ChangeThisImmediately123!
